const DOC = "docs/decisions/2026-08-31-measuring-duplication-and-complexity.md";
const WIDTH = 76;

function wrap(text, indent) {
  const out = [];
  let line = "";
  for (const word of text.split(/\s+/)) {
    if (line && `${line} ${word}`.length > WIDTH) {
      out.push(indent + line);
      line = word;
    } else {
      line = line ? `${line} ${word}` : word;
    }
  }
  if (line) out.push(indent + line);
  return out.join("\n");
}

/** The house violation shape: what broke, why the rule is here, the edit. */
function formatViolation(v) {
  return [
    `x ${v.slug}  ${v.file}:${v.line}`,
    wrap(v.what, "  "),
    wrap(v.why, "  "),
    wrap(v.fix, "  "),
    `  See ${v.doc}.`,
  ].join("\n");
}

function smells() {
  const run = spawnSync(
    "qlty",
    ["smells", "--all", "--sarif", "--no-upgrade-check"],
    { encoding: "utf8", maxBuffer: 64 * 1024 * 1024 },
  );
  if (run.error) {
    console.error(
      `qlty-smells-gate: could not run qlty (${run.error.message}).\n` +
        "Install it from https://qlty.sh, or run this in CI where it is installed.",
    );
    process.exit(2);
  }
  if (run.status !== 0) {
    console.error(`qlty-smells-gate: qlty smells exited ${run.status}.`);
    console.error(run.stderr);
    process.exit(2);
  }
  try {
    return JSON.parse(run.stdout).runs[0].results ?? [];
  } catch (cause) {
    console.error(`qlty-smells-gate: qlty's SARIF did not parse (${cause}).`);
    process.exit(2);
  }
}

/** The count qlty states in its own message, e.g. "(count = 33)". */
function countOf(message) {
  const found = /count = (\d+)/.exec(message);
  return found ? Number(found[1]) : null;
}

/** The number of copies qlty found, e.g. "in 3 locations". */
function locationsOf(message) {
  const found = /in (\d+) locations?/.exec(message);
  return found ? Number(found[1]) : null;
}

/** The symbol qlty names after the colon, e.g. "...(count = 33): KeyboardHelp". */
function symbolOf(message) {
  const found = /:\s*([A-Za-z_$][\w$]*)\s*$/.exec(message);
  return found ? found[1] : null;
}

function judge(result) {
  const rule = result.ruleId;
  const file = result.locations?.[0]?.physicalLocation?.artifactLocation?.uri;
  const line = result.locations?.[0]?.physicalLocation?.region?.startLine ?? 1;
  const message = result.message?.text ?? "";
  const hash = result.properties?.structural_hash ?? null;
  const count = countOf(message);
  const locations = locationsOf(message);
  const symbol = symbolOf(message);
  const finding = {
    rule,
    file,
    line,
    message,
    hash,
    count,
    symbol,
    locations,
  };

  if (hash) {
    const kept = KEPT.find((k) => k.hash === hash);
    if (!kept) return { ...finding, kept: null };
    // A third copy of a kept pair carries the pair's own hash. Without this
    // the gate accepts any number of copies once it has accepted two.
    if (locations !== null && locations > kept.locations) {
      return { ...finding, kept: null, spread: kept };
    }
    return { ...finding, kept };
  }

  const kept = KEPT.find(
    (k) =>
      k.rule === rule &&
      k.file === file &&
      (k.symbol === undefined || k.symbol === symbol),
  );
  if (!kept) return { ...finding, kept: null };
  if (count !== null && kept.max !== undefined && count > kept.max) {
    return { ...finding, kept: null, grew: kept };
  }
  return { ...finding, kept };
}

function violationFor(f) {
  const slug = f.rule.replace(/^qlty:/, "");
  // qlty's message ends without a stop; ours continues the sentence.
  const said = f.message.replace(/\s*$/, "").replace(/([^.])$/, "$1.");
  if (f.grew) {
    return {
      slug,
      file: f.file,
      line: f.line,
      what: `${said} This finding is kept at ${f.grew.max}; it is now ${f.count}.`,
      why:
        "It was accepted at a stated number so that it could not grow in " +
        "silence. A kept finding with no bound is an exclusion wearing a " +
        "reason, and the number is what stops this file drifting past what " +
        "the argument for keeping it covers.",
      fix:
        "Bring it back to " +
        `${f.grew.max} or below, or raise \`max\` for this entry in ` +
        "bin/qlty-smells-gate and say in the same edit what changed about " +
        "the code that makes the larger number right.",
      doc: DOC,
    };
  }
  if (f.spread) {
    return {
      slug,
      file: f.file,
      line: f.line,
      what:
        `${said} This shape was kept in ${f.spread.locations} places; ` +
        `it is now in ${f.locations}.`,
      why:
        "The argument for keeping it was an argument about two copies that " +
        "answer to different bands. A third copy is not covered by it, and " +
        "duplication that spreads is the debt this gate exists to notice.",
      fix:
        "Share the code, or raise `locations` for this entry in " +
        "bin/qlty-smells-gate and say in the same edit why the new copy " +
        "belongs apart from the others.",
      doc: DOC,
    };
  }
  if (f.hash) {
    return {
      slug,
      file: f.file,
      line: f.line,
      what: `${said} Nothing in bin/qlty-smells-gate accounts for it.`,
      why:
        "Duplication is the debt that accumulates quietly, because nothing " +
        "ever fails on it. This gate is the thing that fails on it.",
      fix:
        "Share the code, or - if the two copies are deliberately apart - add " +
        `the structural hash ${f.hash} to KEPT in bin/qlty-smells-gate with ` +
        "the argument for keeping them apart. A pair whose hash changed " +
        "because the code changed needs its argument made again, not its " +
        "hash updated.",
      doc: DOC,
    };
  }
  return {
    slug,
    file: f.file,
    line: f.line,
    what: `${said} Nothing in bin/qlty-smells-gate accounts for it.`,
    why:
      "This is the first time anything has reported it, which means no one " +
      "has decided whether the code is right and the measurement wrong, or " +
      "the other way round. The gate is default-deny so that the decision " +
      "gets made rather than inherited.",
    fix:
      "Split it, or add an entry to KEPT in bin/qlty-smells-gate naming the " +
      `rule (${f.rule}), the file, ` +
      (f.symbol ? `the symbol (${f.symbol}), ` : "") +
      `\`max: ${f.count ?? "the count"}\`, and why the measurement is wrong ` +
      "about this code.",
    doc: DOC,
  };
}

const quiet = process.argv.includes("--quiet");
const judged = smells().map(judge);
const failing = judged.filter((f) => !f.kept);
// By entry, not by `where`: a duplication pair reports once from each end, and
// keyboard-help.tsx carries two different rules about the same function.
const matched = KEPT.filter((entry) => judged.some((f) => f.kept === entry));
const keptCount = matched.length;

if (failing.length > 0) {
  console.error(failing.map((f) => formatViolation(violationFor(f))).join("\n\n"));
  console.error(
    `\n${failing.length} finding${failing.length === 1 ? "" : "s"} not accounted for. ` +
      `${keptCount} kept, each with its reason in bin/qlty-smells-gate.`,
  );
  process.exit(1);
}

if (!quiet) {
  console.log(
    `qlty-smells-gate: clean. ${keptCount} finding${keptCount === 1 ? "" : "s"} ` +
      "deliberately kept, each with its reason in bin/qlty-smells-gate:",
  );
  for (const entry of matched) {
    const rule = entry.rule ? entry.rule.replace(/^qlty:/, "") : "duplication";
    console.log(`  - ${rule}  ${entry.where}`);
  }
  const stale = KEPT.filter((entry) => !matched.includes(entry));
  for (const entry of stale) {
    console.log(
      `  ! ${entry.where} is kept here but qlty no longer reports it - ` +
        "the entry can go.",
    );
  }
}
