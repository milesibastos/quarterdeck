#!/usr/bin/env node
/**
 * Build if needed, then start, and print the URL it bound.
 *
 * The port comes from the absolute path of this worktree, so two checkouts can
 * run their panels side by side and each one always answers on the same URL.
 * See src/config/port.ts.
 *
 * Node 24 runs the TypeScript below by stripping types, so the port derivation
 * has exactly one implementation shared with the server.
 */
import { spawn } from "node:child_process";
import { createServer } from "node:net";
import { existsSync } from "node:fs";
import { cp, mkdir, readFile, readdir, stat, writeFile } from "node:fs/promises";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { derivePort } from "../src/config/port.ts";

const root = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const standalone = join(root, ".next", "standalone");
const server = join(standalone, "server.js");

/**
 * What a child's exit means when it was asked to stop.
 *
 * The standalone server answers a signal by exiting 128 plus the signal's
 * number rather than by dying of it, deliberately, so that a debugger does not
 * hold the exit. Read literally that is a non-zero status and a failure; read
 * as the server means it, it is the stop working. A child killed outright
 * reports the signal instead and no code at all.
 */
const STOPPED_EXIT_CODES = new Set([130, 143]);

function stopped(code, signal) {
  return signal !== null || STOPPED_EXIT_CODES.has(code);
}

/**
 * Runs a command to completion, resolving with how it ended.
 *
 * A stop is not a failure: an exit that says "I was asked to quit" resolves,
 * and the caller decides what to say about it. Only an exit nobody asked for
 * rejects, because only that one is worth a stack trace.
 */
function run(command, args, options = {}) {
  const { onStart, ...spawnOptions } = options;
  return new Promise((resolveRun, rejectRun) => {
    const child = spawn(command, args, { cwd: root, stdio: "inherit", ...spawnOptions });
    child.on("error", rejectRun);
    child.on("exit", (code, signal) =>
      code === 0 || stopped(code, signal)
        ? resolveRun({ code, signal })
        : rejectRun(new Error(`${command} exited with ${code}`)),
    );
    onStart?.(child);
  });
}

/** Newest mtime under a directory, or 0 when it is not there. */
async function newest(dir) {
  let latest = 0;
  const walk = async (at) => {
    for (const entry of await readdir(at, { withFileTypes: true })) {
      if (entry.name === "node_modules" || entry.name.startsWith(".")) continue;
      const path = join(at, entry.name);
      if (entry.isDirectory()) await walk(path);
      else latest = Math.max(latest, (await stat(path)).mtimeMs);
    }
  };
  if (!existsSync(dir)) return 0;
  await walk(dir);
  return latest;
}

async function buildIfNeeded() {
  const builtAt = existsSync(server) ? (await stat(server)).mtimeMs : 0;
  const postcssConfig = join(root, "postcss.config.mjs");
  const sourceAt = Math.max(
    await newest(join(root, "src")),
    await newest(join(root, "public")),
    existsSync(postcssConfig) ? (await stat(postcssConfig)).mtimeMs : 0,
  );
  if (builtAt > sourceAt) return;
  await run("npm", ["run", "build"]);
}

/**
 * `next build --output standalone` emits a server that expects the static
 * assets beside it, but does not copy them itself.
 *
 * The copy is skipped when this exact build's assets are already beside the
 * server, recorded in a marker holding the build's id. Repeating it is not just
 * wasted work: the test suite stages the same directory from several processes
 * at once and guards that with a lock this script does not hold, so a launcher
 * copying over it while a panel is reading it is a torn file in somebody
 * else's test. The marker is the same one `tests/lib/server.ts` reads and
 * writes, so whichever gets there first spares the other the copy.
 */
const stagedMarker = join(standalone, ".assets-staged");

async function stageAssets() {
  await mkdir(join(standalone, ".next"), { recursive: true });
  const buildId = await readFile(join(root, ".next", "BUILD_ID"), "utf8").catch(
    () => null,
  );
  const staged = await readFile(stagedMarker, "utf8").catch(() => null);
  if (buildId !== null && staged === buildId) return;

  await cp(join(root, ".next", "static"), join(standalone, ".next", "static"), {
    recursive: true,
  });
  if (existsSync(join(root, "public"))) {
    await cp(join(root, "public"), join(standalone, "public"), { recursive: true });
  }
  if (buildId !== null) await writeFile(stagedMarker, buildId);
}

const port = process.env.QUARTERDECK_PORT || String(derivePort(root));
const host = "127.0.0.1";

await buildIfNeeded();
await stageAssets();

const url = `http://${host}:${port}`;

/**
 * Refuse before starting if the port is taken.
 *
 * Otherwise Next binds, fails, and prints a stack trace - and any probe we did
 * afterwards would be answered by whatever already holds the port, so we would
 * cheerfully announce someone else's panel as ours.
 */
function portIsFree() {
  return new Promise((settle) => {
    const probe = createServer();
    probe.once("error", () => settle(false));
    probe.once("listening", () => probe.close(() => settle(true)));
    probe.listen(Number(port), host);
  });
}

if (!(await portIsFree())) {
  process.stderr.write(
    `Port ${port} is already in use. Another quarterdeck from this worktree is ` +
      `probably already running on ${url}.\n` +
      `Stop it, or set QUARTERDECK_PORT to run a second one.\n`,
  );
  process.exit(1);
}

/**
 * Announce the URL only once the panel answers on it.
 *
 * Printing first is a lie whenever the start fails - the operator reads a URL
 * and the server exits below it, and the two lines disagree.
 */
async function announceWhenListening(child) {
  const deadline = Date.now() + 30_000;
  while (Date.now() < deadline) {
    if (child.exitCode !== null) return;
    try {
      await fetch(url, { headers: { host } });
      process.stdout.write(`quarterdeck listening on ${url}\n`);
      return;
    } catch {
      await new Promise((wait) => setTimeout(wait, 100));
    }
  }
  process.stdout.write(`quarterdeck did not answer on ${url} within 30s\n`);
}

/**
 * Pass a polite quit request on, and outlive what it was asked of.
 *
 * The panel is a grandchild of the operator's shell: the shell signals the job,
 * every process in it gets the signal at once, and this one - which has nothing
 * to tear down - is always the first to go. The prompt then comes back while
 * the panel is still shutting down behind it, and anything the panel says on
 * its way out lands on top of a prompt the operator has already been given,
 * looking like a crash that happened after the job ended. So the signal is
 * caught rather than taken: the child is told, this process waits for it, and
 * only then does it end itself the same way it was asked to, which is what the
 * shell reports. See `docs/decisions/2026-09-01-stopping-the-panel.md`.
 */
let stopSignal = null;

function forwardStopSignals(child) {
  for (const signal of ["SIGINT", "SIGTERM"]) {
    process.on(signal, () => {
      stopSignal = signal;
      // Harmless when the child already had it from the process group, and the
      // whole of the stop when the signal was aimed at this process alone.
      child.kill(signal);
    });
  }
}

const ended = await run("node", [server], {
  onStart: (child) => {
    forwardStopSignals(child);
    announceWhenListening(child);
  },
  env: {
    ...process.env,
    // Loopback only. Never an address reachable from the network.
    HOSTNAME: host,
    PORT: port,
    QUARTERDECK_PORT: port,
    QUARTERDECK_FIXTURE_ROOT: join(root, "fixtures"),
  },
});

if (stopSignal) {
  // Re-raise what was asked, now that the panel is actually gone, so the shell
  // reports the stop it requested rather than an exit status standing in for it.
  process.removeAllListeners(stopSignal);
  process.kill(process.pid, stopSignal);
} else if (stopped(ended.code, ended.signal)) {
  // Nobody in this terminal asked for that. An operator whose panel vanishes
  // has to be able to find out why, so the one thing known about it - that
  // something outside this terminal asked the panel to quit, and how - is said
  // rather than left as a silent exit.
  process.stderr.write(
    `quarterdeck stopped: something outside this terminal asked the panel on ${url} to quit ` +
      `(${ended.signal ? `killed by ${ended.signal}` : `exited ${ended.code}`}).\n`,
  );
  process.exit(ended.code ?? 1);
}
